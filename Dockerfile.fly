FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true

RUN corepack enable
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/coordinator/package.json packages/coordinator/package.json
COPY packages/indexer/package.json packages/indexer/package.json

RUN pnpm install --frozen-lockfile \
  --filter @kakure/coordinator... \
  --filter @kakure/indexer...

COPY packages/coordinator packages/coordinator
COPY packages/indexer packages/indexer
COPY packages/sdk/src/solana/idl/kakure_pool.json packages/sdk/src/solana/idl/kakure_pool.json

RUN pnpm --filter @kakure/coordinator build \
  && pnpm --filter @kakure/indexer build \
  && pnpm --filter @kakure/coordinator deploy --legacy --prod /prod/coordinator \
  && pnpm --filter @kakure/indexer deploy --legacy --prod /prod/indexer

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /prod/coordinator ./coordinator
COPY --from=build /prod/indexer ./indexer
COPY --from=build /app/packages/sdk/src/solana/idl/kakure_pool.json ./packages/sdk/src/solana/idl/kakure_pool.json

USER node
