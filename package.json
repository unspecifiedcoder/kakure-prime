{
  "name": "kakure",
  "private": true,
  "version": "0.1.0",
  "description": "Confidential prime brokerage for tokenized equities on Solana",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "deploy:meteora-devnet": "node scripts/deploy-meteora-dbc.mjs",
    "trade:meteora-devnet": "node scripts/trade-meteora-dbc.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "rpc-websockets>uuid": "11.1.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "bigint-buffer",
      "blake-hash",
      "bufferutil",
      "esbuild",
      "leveldown",
      "msgpackr-extract",
      "utf-8-validate"
    ]
  },
  "dependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.12",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5"
  }
}
