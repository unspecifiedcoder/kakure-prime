use poseidon::poseidon::bn254::hash_3;

pub global TREE_DEPTH: u32 = 32;

// BabyJubJub prime-order subgroup order: https://docs.iden3.io/publications/pdfs/Baby-Jubjub.pdf
pub global SUBORDER: Field =
    2736030358979909402780800718157159386076813972158567259200215660948447373041;

pub fn assert_subgroup_scalar(x: Field) {
    assert(x != 0, "scalar must be non-zero");
    assert(x.lt(SUBORDER), "scalar not in BabyJubJub prime-order subgroup");
}

pub fn lean_imt_inclusion_proof<let MAX_DEPTH: u32>(
    leaf: Field,
    leaf_index: Field,
    siblings: [Field; MAX_DEPTH],
) -> Field {
    let path_bits: [bool; MAX_DEPTH] = leaf_index.to_le_bits();
    let mut current = leaf;

    for i in 0..MAX_DEPTH {
        let sibling = siblings[i];
        if sibling != 0 {
            let path_bit = path_bits[i] as Field;
            let left = current + path_bit * (sibling - current);
            let right = current + sibling - left;

            current = hash_3([left, right, i as Field]);
        } else {
            assert(!path_bits[i], "non-canonical leaf index: right child at empty level");
        }
    }
    current
}

#[test]
pub fn test_lean_imt_inclusion_proof() {
    let leaf: Field = (4 as u8).into();
    let leaf_index: Field = (3 as u8).into();
    let siblings: [Field; 8] = [
        3,
        0x038682aa1cb5ae4e0a3f13da432a95c77c5c111f6f030faf9cad641ce1ed7383,
        0x232400b3cca0da78d26295f345d21e9bf8949238bee02b285140ebf183119982,
        0,
        0,
        0,
        0,
        0,
    ];
    let root = lean_imt_inclusion_proof(leaf, leaf_index, siblings);
    // Poseidon v1 (was Poseidon2 pre-switch); recomputed with poseidon::poseidon::bn254::hash_3.
    assert(root == 0x2464ff7554dd54fdfd484d5f6602e2d240aa97aeb85e6037852a7faa971fc55b);
}

#[test]
fn test_subgroup_scalar_accepts_max() {
    assert_subgroup_scalar(SUBORDER - 1);
}

#[test(should_fail_with = "scalar not in BabyJubJub prime-order subgroup")]
fn test_subgroup_scalar_rejects_over() {
    assert_subgroup_scalar(SUBORDER + 1);
}

// Depth 32 is frozen: it must match the on-chain MERKLE_TREE_DEPTH and the TS LeanIMT default.
#[test]
fn kat_tree_depth_frozen() {
    assert(TREE_DEPTH == 32, "LeanIMT depth is a frozen seam: must stay 32");
}


