#[test]
fn kat_cross_check_hash_3() {
    let h = poseidon::poseidon::bn254::hash_3([1, 2, 3]);
    assert(h == 0xe7732d89e6939c0ff03d5e58dab6302f3230e269dc5b968f725df34ab36d732);
}
