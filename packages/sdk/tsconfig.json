{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Match the reference EVM implementation's own tsconfig (which lacks both flags): most of this package is ported, audited
    // crypto code, and we do not retrofit non-null assertions into it just to satisfy stricter flags.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
