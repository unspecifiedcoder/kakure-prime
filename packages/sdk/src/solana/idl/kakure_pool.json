      ],
      "accounts": [
        { "name": "authority", "signer": true, "writable": true, "note": "payer" },
        { "name": "pool", "writable": true, "pda": ["pool"] },
        { "name": "system_program" }
      ]
    },
    {
      "tag": 1, "name": "set_verifier",
      "args": [ { "name": "circuit_id", "type": "u8" }, { "name": "program", "type": "Pubkey" } ],
