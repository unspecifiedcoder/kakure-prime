{
  "name": "@kakure/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kakure-indexer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'"
  },
  "author": "Kakure Labs",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^13.0.3",
    "bs58": "^6.0.0",
    "fastify": "^5.12.3",
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
